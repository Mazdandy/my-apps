{
  "name": "my-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo berisi beberapa aplikasi web (wedding, qa-helper, cv-reviewer, yt-downloader).",
  "workspaces": [
    "wedding",
    "qa-helper",
    "cv-reviewer",
    "yt-downloader/frontend",
    "yt-downloader/backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
