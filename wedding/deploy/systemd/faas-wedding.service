[Unit]
Description=FAAS Wedding Invitation (Next.js, port 3001)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=0.0.0.0
# Public base URL for share links / WhatsApp invitations
Environment=APP_URL=https://loveonthe.cloud
ExecStart=/usr/bin/node __APP_DIR__/.next/standalone/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
