generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum PlanCode {
  FREE
  PRO
  BUSINESS
}

enum PlanPeriod {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  EXPIRED
}

enum RsvpStatus {
  YES
  MAYBE
  NO
}

enum WishStatus {
  VISIBLE
  HIDDEN
  FLAGGED
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String
  role           Role           @default(USER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  subscriptions  Subscription[]
  invitations    Invitation[]
  payments       Payment[]
}

model Plan {
  id            String   @id @default(cuid())
  code          PlanCode @unique
  name          String
  description   String?
  price         Int      // in Rupiah per period
  period        PlanPeriod
  periodDays    Int
  maxPages      Int      // 0 = unlimited
  maxGuests     Int      // per page, 0 = unlimited
  freeTemplates Boolean  @default(false)
  analytics     Boolean  @default(false)
  noBranding    Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  plan  Plan  @relation(fields: [planId], references: [id])

  payments Payment[]

  @@index([userId, status])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String
  amount         Int
  gateway        String        @default("mock")
  status         PaymentStatus @default(PENDING)
  reference      String?       @unique
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  user         User         @relation(fields: [userId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String   @default("wedding")
  description String?
  price       Int      @default(0)
  thumbnail   String?
  coverImage  String?
  free        Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invitations Invitation[]
}

model Invitation {
  id            String           @id @default(cuid())
  userId        String
  templateId    String
  slug          String           @unique
  status        InvitationStatus @default(DRAFT)
  title         String
  data          String           @default("{}") // JSON payload
  coverMedia    String?
  musicUrl      String?
  eventAt       DateTime
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  template Template @relation(fields: [templateId], references: [id])

  guests Guest[]
  rsvps  Rsvp[]
  wishes Wish[]
  aliases InvitationAlias[]

  @@index([slug, status])
}

model InvitationAlias {
  id           String   @id @default(cuid())
  slug         String   @unique
  invitationId String
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id])

  @@index([invitationId])
}

model Guest {
  id           String   @id @default(cuid())
  invitationId String
  name         String
  phone        String?
  group        String?
  token        String   @unique
  sentStatus   Boolean  @default(false)
  openedAt     DateTime?
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id])
  rsvp       Rsvp?
}

model Rsvp {
  id           String    @id @default(cuid())
  invitationId String
  guestId      String    @unique
  status       RsvpStatus
  qtyAdult     Int       @default(1)
  qtyChild     Int       @default(0)
  note         String?
  answers      String    @default("{}")
  createdAt    DateTime  @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id])
  guest     Guest      @relation(fields: [guestId], references: [id])
}

model Wish {
  id           String     @id @default(cuid())
  invitationId String
  name         String
  message      String
  status       WishStatus @default(VISIBLE)
  createdAt    DateTime   @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id])

  @@index([invitationId, status])
}
