# Backend configuration (all optional)
PORT=8787
# Path to yt-dlp binary
YTDLP_PATH=yt-dlp
# Directory for temp download files (deleted after streaming)
# TEMP_DIR=/tmp

# Comma-separated CORS origins, or * for all
# CORS_ORIGINS=http://localhost:3000

# HEVC->H.264 transcode timeout in ms (TikTok/Instagram HEVC streams)
# TRANSCODE_TIMEOUT_MS=120000

# Netscape-format cookies file passed to yt-dlp (--cookies). Helps a LOT with
# TikTok/Instagram bot-blocking. Export cookies from a logged-in browser as a
# text file (e.g. "cookies.txt") and point here. Optional.
COOKIES_FILE=/path/to/cookies.txt

# Max concurrent downloads is fixed at 3 (PRD FR-13) and not configurable.
